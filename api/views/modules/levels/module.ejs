<%- include('../modules.ejs') %>

<style>
    .card textarea {
        width: 100%;
        max-width: 400px;
        height: 80px;
        display: block;
        margin-bottom: 10px;
    }

    .card button {
        background-color: #161f25;
        color: white;
        border-radius: 20px;
        padding: 8px 20px;
        cursor: pointer;
        border: none;
    }
</style>

<div class="main-content">
    <header style="margin-bottom: 30px;">
        <h1 style="margin: 0;">レベルモジュール</h1><br/>

        <div style="display: flex; align-items: center; gap: 15px;">
            <label class="switch-container" style="position: relative; display: inline-block; width: 46px; height: 24px;">
            <input type="checkbox" 
                class="module-toggle" 
                id="module_setting"
                data-guild-id="<%= guild.id %>" 
                data-module-path="<%= path %>"
                <%= enabled ? 'checked' : '' %>
                style="opacity: 0; width: 0; height: 0;">
            <span class="slider" style="position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: #72767d; transition: .4s; border-radius: 24px;"></span>
            </label>
            <span class="status-text" style="font-size: 0.85rem; font-weight: bold; min-width: 35px; color: <%= enabled ? 'var(--success)' : 'var(--text-muted)' %>">
                <%= enabled ? '有効' : '無効' %>
            </span>
        </div>
    </header>

    <div class="card">
        <div style="display: flex; align-items: center; gap: 15px;">
            /rank （現在のレベルを表示します。）<label class="switch-container" style="position: relative; display: inline-block; width: 46px; height: 24px;">
            <input type="checkbox" 
                class="module-toggle" 
                id="rank_commands"
                data-guild-id="<%= guild.id %>" 
                data-module-path="<%= path %>"
                <%= rank_commands_enabled ? 'checked' : '' %>
                style="opacity: 0; width: 0; height: 0;">
            <span class="slider" style="position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: #72767d; transition: .4s; border-radius: 24px;"></span>
            </label>
            <span class="status-text" style="font-size: 0.85rem; font-weight: bold; min-width: 35px; color: <%= enabled ? 'var(--success)' : 'var(--text-muted)' %>">
                <%= rank_commands_enabled ? '有効' : '無効' %>
            </span>
        </div>
    </div><br/>

    <div class="card">
        <h3>
            レベルアップ通知の設定
        </h3>

        <p>
            <h4>送信先チャンネル</h4>
            <select id="channel" style="margin-bottom: 15px;">
                <option value="message_reply">メッセージに返信する</option>
                <% channels.forEach(ch => { %>
                    <% if (ch.type !== 4) { %>
                        <option value="<%= ch.id %>"># <%= ch.name %></option>
                    <% } %>
                <% }); %>
            </select>
            <h4>埋め込みのタイトル</h4>
            <textarea id="message_title"><%= msg_title %></textarea>
            <h4>埋め込みの説明</h4>
            <textarea id="message_description"><%= msg_description %></textarea>
            <br/>
            <button onclick="updateLevelUpMessage()">更新</button>
        </p>
    </div>
</div>
<script>
    document.getElementById("rank_commands").addEventListener('change', async (e) => {
        const isEnabled = e.target.checked;
        const guildId = e.target.dataset.guildId;
        const moduleName = e.target.dataset.modulePath;
        const statusText = e.target.parentElement.nextElementSibling;

        statusText.innerText = isEnabled ? '有効' : '無効';
        statusText.style.color = isEnabled ? 'var(--success)' : 'var(--text-muted)';

        try {
            const response = await fetch(`/api/modules/commands`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ enabled: isEnabled, module: moduleName, command: "rank", guildId: guildId })
            });

            if (!response.ok) throw new Error('保存に失敗しました');
        } catch (err) {
            alert('リクエストが早すぎます。');
            e.target.checked = !isEnabled;
            statusText.innerText = !isEnabled ? '有効' : '無効';
        }
    });

    document.getElementById("module_setting").addEventListener('change', async (e) => {
        const isEnabled = e.target.checked;
        const guildId = e.target.dataset.guildId;
        const moduleName = e.target.dataset.modulePath;
        const statusText = e.target.parentElement.nextElementSibling;

        statusText.innerText = isEnabled ? '有効' : '無効';
        statusText.style.color = isEnabled ? 'var(--success)' : 'var(--text-muted)';

        try {
            const response = await fetch(`/api/modules/toggle`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ guildId, module: moduleName })
            });

            if (!response.ok) throw new Error('保存に失敗しました');
        } catch (err) {
            alert('設定の保存中にエラーが発生しました');
            e.target.checked = !isEnabled;
            statusText.innerText = !isEnabled ? '有効' : '無効';
        }
    });

    async function updateLevelUpMessage() {
        const guildId = "<%= guild.id %>";
        const title_value = document.getElementById("message_title").value;
        const description_value = document.getElementById("message_description").value;
        const channel = document.getElementById("channel").value;

        try {
            const response = await fetch(`/api/guilds/${guildId}/levels/message`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ 
                    title: title_value, 
                    description: description_value, 
                    channel: channel
                })
            });

            if (response.ok) {
                alert("レベルアップ時メッセージを指定しました。");
            } else {
                throw new Error();
            }
        } catch (err) {
            alert("指定に失敗しました。");
        }
    }
</script>